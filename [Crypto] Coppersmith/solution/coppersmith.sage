#use https://sagecell.sagemath.org to run this script

#given values
N = 

e = 65537
c = 

p_hint = 10563202235654127804029767430163826593701264606134397319260690365710536013667470002080978227573233906681454190080146209547145845275356759742747348161265664

PR.<x> = PolynomialRing(Zmod(N))

f = p_hint + x

#bound on 92 unknown bits
X = 2^92

roots = f.small_roots(X=X, beta=0.5)
assert roots, "No root"

x0 = ZZ(roots[0])

p = p_hint + x0
q = N // p

assert N % p == 0

#standard method
phi = (p - 1) * (q - 1)
d = inverse_mod(e, phi)
m = power_mod(c, d, N)

print(bytes.fromhex(hex(m)[2:]))